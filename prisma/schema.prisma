datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  STUDENT
  COUNSELLOR
  PSYCHOLOGIST
  SUPPORT_STAFF
  SCHOOL_ADMIN
  PLATFORM_ADMIN
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum ChatThreadStatus {
  PENDING
  ACTIVE
  CLOSED
}

enum ChatMessageRole {
  STUDENT
  PROFESSIONAL
  SYSTEM
}

enum FeelingLabel {
  OVERWHELMED
  ANXIOUS
  TIRED
  SAD_LOW
  CALM
  HOPEFUL
  GREAT
  HAPPY
  PEACEFUL
  STRESSED
  DOWN
  ANGRY
}

enum FeelingIntensity {
  A_LITTLE
  SOMEWHAT
  A_LOT
}

/// US-D04: an unanswered check-in field is a recorded state, never an absence a
/// rule can read as calm. NOT_PRESENTED means the prompt was not shown (the
/// library gates it), which is not the same as the student declining it.
enum CheckInAnswerState {
  ANSWERED
  SKIPPED
  PREFER_NOT_TO_SAY
  NOT_PRESENTED
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ResourceType {
  ARTICLE
  AUDIO_GUIDE
  SOMATIC_EXERCISE
  INTERACTIVE
  SOUNDSCAPE
  AFFIRMATION
  TOOLKIT_ITEM
}

/// The Doc B §5 four-way "what next?" answer after a resource. Never an
/// indicator: Doc C §5.1 forbids a click or refusal becoming risk signal.
enum ResourceFeedbackChoice {
  NOT_HELPFUL
  TRY_SOMETHING_ELSE
  WANT_TO_TALK
  DECLINED
}

/// The eight values after GENERAL are the approved student-facing taxonomy
/// (Doc B §3), which the resource surfaces present and filter by. The eleven
/// before it stay because `WellbeingActivity` and the AI activity catalogue
/// already key off GROUNDING/SLEEP/ANXIETY/GENERAL, and the five withdrawn
/// placeholder rows still carry their original value — a Postgres enum value
/// cannot be dropped while any row uses it.
enum ResourceCategory {
  EXAM_STRESS
  FRIENDSHIPS
  FAMILY
  IDENTITY
  ANXIETY
  GROUNDING
  SLEEP
  FOCUS
  CULTURAL_WISDOM
  PEER_DYNAMICS
  GENERAL
  FEELINGS
  STEADIER
  ONE_STEP
  KINDNESS
  DIFFICULT_MOMENT
  HEAVY
  ASK_FOR_SUPPORT
  REST
}

enum SupportPersonType {
  COUNSELLOR
  PSYCHOLOGIST
  SUPPORT_STAFF
  TRUSTED_TEACHER
  PARENT_GUARDIAN
}

enum SupportTiming {
  GENTLE_1_2_DAYS
  TODAY_STUDY_PERIOD
  URGENT_UNSAFE
}

enum SupportRequestStatus {
  PENDING
  ACCEPTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ESCALATED
}

enum SupportFlagSeverity {
  TIER_1_MODERATE
  TIER_2_HIGH
  TIER_3_ACUTE
}

enum SupportFlagStatus {
  OPEN
  IN_REVIEW
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

enum SupportFlagSource {
  AI_CANDIDATE
  SERVER_POLICY
  PROFESSIONAL
  SELF_REPORT
}

/// Doc A indicator levels. U means the evidence is unclear or conflicting, not
/// low-risk, and must never be rendered as a milder shade of A.
enum IndicatorLevel {
  A
  B
  C
  U
}

enum SupportFlagReviewDecision {
  NO_FURTHER_ACTION
  FOLLOW_UP_WITH_STUDENT
  FOLLOW_SAFEGUARDING_PROCEDURE
}

enum AiJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AiJobKind {
  REPLY
  SUMMARY
  VERNACULAR
}

enum FollowUpStatus {
  PENDING
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// A reviewer's read of a reported AI response. Record-only: none of these
/// changes the AI's reply, the student's conversation, or the reported text.
enum AiReportReviewOutcome {
  NO_CHANGE_NEEDED
  FOLLOWED_UP_WITH_STUDENT
  CANNOT_ASSESS
}

/// Why the student flagged an AI reply, chosen by the student from a fixed set
/// (Epic G "Did something feel off?"). These are report categories, not
/// wellbeing content, so they are deliberately outside the content register:
/// gating the reporting path behind a review workflow could hide the one
/// control a student has over a bad reply.
enum AiReportReason {
  DIAGNOSIS_OR_MEDICAL_ADVICE
  UNSAFE_OR_UNKIND
  DID_NOT_UNDERSTAND
  OTHER
}

/// What a student asks to have removed (Epic H "Ask to delete your history?").
/// A request, never an action: nothing in this product deletes wellbeing data on
/// a student's say-so, because some of it may have to be kept for safeguarding or
/// legal reasons — so the row records the ask and a person decides.
enum HistoryDeletionScope {
  ALL_HISTORY
  BEFORE_DATE
  SELECTED_CHECK_INS
}

// --- Content registry (Doc C §6/§7) -----------------------------------------------------
// Every reviewer-editable string (emotion term, check-in prompt, response option, resource,
// category) is a versioned row here, NOT hard-coded, so nothing reaches a student until an
// authorised reviewer approves THAT exact version. Three namespaces carry different approval
// controls (education/wellbeing/safeguarding); `status` is the gate and `resolve()` only ever
// returns APPROVED_ACTIVE rows whose effective window contains "now".

enum ContentKind {
  EMOTION_TERM
  CHECKIN_PROMPT
  RESPONSE_OPTION
  WELLBEING_RESOURCE
  WELLBEING_ACTIVITY
  SAFEGUARDING_PROMPT
  AGE_BAND_RULE
  CATEGORY
}

enum ContentStatus {
  DRAFT
  CONTENT_REVIEW_REQUIRED
  APPROVED_ACTIVE
  BLOCKED
  SUPERSEDED
  RETIRED
}

enum ApprovalNamespace {
  EDUCATION
  WELLBEING
  SAFEGUARDING
}

/// A versioned content item. Meaning or safety change ⇒ bump major; a new item or age
/// variant ⇒ minor; a non-meaningful fix ⇒ patch. Rollback = flip status/effectiveTo on the
/// live row and re-activate the parent it supersedes — no deploy. `payload` holds wording,
/// response options, steps, safety note; never copied student text.
model ContentItem {
  id            String            @id @default(uuid()) @db.Uuid
  code          String // EMO-003 / CP-05 / WN-07 / AGE-13-15
  kind          ContentKind
  namespace     ApprovalNamespace
  status        ContentStatus     @default(DRAFT)
  majorVersion  Int               @default(1)
  minorVersion  Int               @default(0)
  patchVersion  Int               @default(0)
  payload       Json
  ageBand       String? // null = all bands
  locale        String            @default("en")
  approvedBy    String? // reviewer identity, not a bare boolean
  approvedAt    DateTime?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  supersedesId  String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([code, majorVersion, minorVersion, patchVersion, locale])
  @@index([kind, status, locale, ageBand])
  @@map("content_item")
}

/// A tenant school. Soft delete = status SUSPENDED: sign-in is blocked and all
/// school users are cut off (see tenant.guard.ts + the school-status-guard
/// Better Auth plugin in auth.config.ts).
model School {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String
  shortCode           String       @unique
  status              SchoolStatus @default(ACTIVE)
  /// Precomputed scrypt hash (better-auth/crypto) of the school's default
  /// password. Reused as the credential for every onboarded account until the
  /// user's forced first change; never returned by any endpoint.
  defaultPasswordHash String?
  settings            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  users       User[]
  chatThreads ChatThread[]
  auditLogs   AuditLog[]

  @@map("school")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  phone              String?   @unique
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  role               UserRole  @default(STUDENT)
  schoolId           String?   @db.Uuid
  /// Set when onboarded with the school default password; cleared by
  /// POST /api/v1/auth/first-password. Blocks all other routes (tenant.guard).
  mustChangePassword Boolean   @default(false)
  deactivatedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions            Session[]
  accounts            Account[]
  studentProfile      StudentProfile?
  professionalProfile ProfessionalProfile?
  auditLogs           AuditLog[]
  school              School?              @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  notifications       Notification[]
  sentChatMessages    ChatMessage[]
  reviewedAiReports   AiResponseReport[]   @relation("AiReportReview")
  supportRequestReads SupportRequestRead[]

  @@index([schoolId])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String
  providerId            String
  password              String?
  idToken               String?
  scope                 String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model StudentProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  firstName         String
  lastName          String?
  displayName       String?
  classLabel        String?
  studentRef        String?  @unique
  /// System-assigned onboarding code: <SCHOOL_SHORTCODE>-<4 digits>.
  studentCode       String?  @unique
  preferredLanguage String   @default("en")
  vibe              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns          EmotionalCheckIn[]
  checkInFeedbacks  CheckInFeedback[]
  conversations     Conversation[]
  supportRequests   SupportRequest[]
  supportFlags      SupportFlag[]
  followUps         FollowUp[]
  journalEntries    JournalEntry[]
  toolboxItems      ToolboxItem[]
  resourceFeedbacks ResourceFeedback[]
  consentRecords    ConsentRecord[]
  privacyPreference PrivacyPreference?
  deletionRequests  HistoryDeletionRequest[]
  sessionSummaries  SessionSummary[]
  activitySessions  ActivitySession[]
  chatThreads       ChatThread[]

  @@map("student_profile")
}

model ProfessionalProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  title      String?
  department String?
  available  Boolean  @default(true)
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supportPeople SupportPerson[]
  assignedFlags SupportFlag[]   @relation("FlagAssignee")
  followUps     FollowUp[]
  chatThreads   ChatThread[]    @relation("ChatProfessional")

  @@map("professional_profile")
}

model ConsentRecord {
  id         String         @id @default(uuid()) @db.Uuid
  studentId  String         @db.Uuid
  version    String
  accepted   Boolean        @default(false)
  acceptedAt DateTime?
  metadata   Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, version])
  @@index([studentId])
  @@map("consent_record")
}

model PrivacyPreference {
  id                              String         @id @default(uuid()) @db.Uuid
  studentId                       String         @unique @db.Uuid
  shareAiCopingHubNotes           Boolean        @default(false)
  allowParentGuardianNotification Boolean        @default(false)
  requestPeerSupportCompanion     Boolean        @default(false)
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt
  student                         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("privacy_preference")
}

/// Epic H. One row per ask, kept exactly as asked. The ask itself deletes
/// nothing — the worker that reads `scheduledPurgeAt` does, after the student's
/// 24-hour undo window has closed. The row keeps the ask verbatim (scope, the
/// date or the check-in ids, the student's own note) so what was erased, and
/// when, is reconstructable from what was actually requested.
model HistoryDeletionRequest {
  id        String               @id @default(uuid()) @db.Uuid
  studentId String               @db.Uuid
  scope     HistoryDeletionScope
  /// Only for BEFORE_DATE. A day, not a moment — the student picks a date.
  beforeDate DateTime?          @db.Date
  /// Only for SELECTED_CHECK_INS. Ids are frozen as submitted, so the ask is
  /// still reconstructable against the rows that were later erased.
  checkInIds String[]           @default([])
  note      String?              @db.VarChar(2000)
  /// Set once a person at the school has actually been told. Kept for the
  /// receipt: notification is informational now — the student decides, not staff.
  alertedAt DateTime?
  /// The moment this ask becomes an erasure. Stamped by create() as
  /// "now + the undo window"; NULL on rows written before the engine existed,
  /// which the worker deliberately leaves alone.
  /// TIMESTAMPTZ on purpose: due-ness is decided by Postgres NOW() in the
  /// worker's own interval arithmetic, never by an app-side Date.
  scheduledPurgeAt DateTime?     @db.Timestamptz(6)
  /// Only inside the window. A cancelled ask is never purged, by any path.
  cancelledAt DateTime?          @db.Timestamptz(6)
  /// Set when the erasure ran. Only ever set on the partial scopes: an
  /// ALL_HISTORY purge deletes the student, and this row cascades away with
  /// them — `history_deletion.executed` in the audit log is that erasure's only
  /// surviving record, and it holds no personal content.
  purgedAt DateTime?             @db.Timestamptz(6)
  /// Why a due erasure did NOT run — e.g. the account cannot sign in, which
  /// would make the undo window meaningless. Shown on the receipt, and the
  /// worker re-checks it on a later pass.
  holdReason String?
  /// What the erasure actually removed, so a partial-scope receipt can say so
  /// in counts rather than in the student's own words having been "cleared".
  removedCheckIns      Int     @default(0)
  removedConversations Int     @default(0)
  createdAt DateTime            @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  /// The worker's due-scan index is a PARTIAL index owned by the hand-written
  /// migration (`WHERE "purgedAt" IS NULL AND "cancelledAt" IS NULL`). Prisma
  /// cannot express a partial index, so it is deliberately absent here — the
  /// same raw-SQL-owned pattern as `session_summary.embedding`.
  @@map("history_deletion_request")
}

model EmotionalCheckIn {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  feeling     FeelingLabel
  intensity   FeelingIntensity
  description String?
  triggers    String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  student           StudentProfile            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  supportRequests   SupportRequest[]
  feedback          CheckInFeedback?
  feelingSelections CheckInFeelingSelection[]
  answers           CheckInAnswer[]

  @@index([studentId, createdAt])
  @@map("emotional_check_in")
}

/// Doc C multi-select feelings. The label is snapshotted because the register
/// version can change or retire later; `feeling` above keeps carrying the single
/// primary label so existing dashboards and CheckInFeedback read one release
/// behind the change.
model CheckInFeelingSelection {
  id                String   @id @default(uuid()) @db.Uuid
  checkInId         String   @db.Uuid
  termCode          String?
  termLabelSnapshot String
  isStudentFreeText Boolean  @default(false)
  createdAt         DateTime @default(now())

  checkIn EmotionalCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId])
  @@map("check_in_feeling_selection")
}

/// One row per check-in prompt that was part of the flow, answered or not, so a
/// skip stays visible as a skip (US-D04). `promptCode` / `valueCode` are register
/// codes; free text is the student's own words, never a risk signal by itself.
model CheckInAnswer {
  id         String             @id @default(uuid()) @db.Uuid
  checkInId  String             @db.Uuid
  promptCode String
  state      CheckInAnswerState
  valueCode  String?
  freeText   String?
  createdAt  DateTime           @default(now())

  checkIn EmotionalCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@unique([checkInId, promptCode])
  @@index([promptCode, state])
  @@map("check_in_answer")
}

/// Post-check-in mood feedback: asked after every check-in ("how do you feel
/// now?"), stored separately from the check-in itself so the platform admin
/// report can measure the check-in's effect on a student's mood. One row per
/// check-in (unique checkInId).
model CheckInFeedback {
  id        String           @id @default(uuid()) @db.Uuid
  checkInId String           @unique @db.Uuid
  studentId String           @db.Uuid
  feeling   FeelingLabel
  intensity FeelingIntensity
  createdAt DateTime         @default(now())

  checkIn EmotionalCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  student StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("check_in_feedback")
}

model Conversation {
  id        String             @id @default(uuid()) @db.Uuid
  studentId String             @db.Uuid
  checkInId String?            @db.Uuid
  source    String?
  /// Last confident language used in this conversation. A silent message
  /// (short / unmarked text) continues this language instead of snapping back
  /// to the student's preference. null until the first confident detection.
  language  String?
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  student          StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkIn          EmotionalCheckIn?     @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  messages         ConversationMessage[]
  supportRequests  SupportRequest[]
  supportFlags     SupportFlag[]
  summary          SessionSummary?
  activitySessions ActivitySession[]

  @@index([studentId, createdAt])
  @@map("conversation")
}

model ConversationMessage {
  id                  String            @id @default(uuid()) @db.Uuid
  conversationId      String            @db.Uuid
  role                MessageRole
  content             String
  /// Guided-reply marker when the student tapped a quick reply instead of
  /// typing free text (TELL_MORE | SHOW_IDEA | TALK_TO_SOMEONE). null = the
  /// student typed. The marker alone picks the reply directive; there is no
  /// turn budget, so nothing is counted off it.
  quickReply          String?
  /// True when the student sent this turn from a voice transcription (the
  /// transcript is posted as plain content; this flag keeps the two lanes
  /// distinguishable server-side). Pilot-analytics signal only.
  viaVoice            Boolean           @default(false)
  /// Language this turn was in (student's message: detected language; reply:
  /// the language it was written in). Lets history show the model each
  /// turn's language. null on messages written before this column existed.
  language            String?
  aiPayload           Json?
  activeExerciseLabel String?
  createdAt           DateTime          @default(now())
  conversation        Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiGenerationJob     AiGenerationJob?
  report              AiResponseReport?

  @@index([conversationId, createdAt])
  @@map("conversation_message")
}

model AiResponseReport {
  id               String                 @id @default(uuid()) @db.Uuid
  messageId        String                 @unique @db.Uuid
  responseContent  String
  responseLanguage String?
  /// Reports submitted before Epic G carry no reason; the submit path has
  /// required one since, so only historical rows are null.
  reason           AiReportReason?
  note             String?                @db.VarChar(2000)
  /// Reviewer decision recorded in the school's review queue. Nullable = not
  /// reviewed yet; the last decision by any same-school reviewer wins.
  reviewOutcome    AiReportReviewOutcome?
  reviewedById     String?                @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime               @default(now())
  message          ConversationMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reviewedBy       User?                  @relation("AiReportReview", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@map("ai_response_report")
}

model WellbeingResource {
  id                String             @id @default(uuid()) @db.Uuid
  title             String
  description       String
  type              ResourceType
  category          ResourceCategory   @default(GENERAL)
  badge             String?
  durationMinutes   Int?
  durationLabel     String?
  ctaLabel          String?
  mediaUrl          String?
  tags              String[]           @default([])
  /// Register code (WN-*) this row implements; approval state lives on the
  /// ContentItem, never here. Nullable so every pre-Epic-D row stays valid.
  contentCode       String?            @unique
  /// Doc B §2 detail template. All nullable: a row may be published on the
  /// legacy description-only surface until its approved copy is imported.
  intendedSituation String?
  instructions      String[]           @default([])
  reflectionPrompt  String?
  safetyNote        String?
  active            Boolean            @default(true)
  approved          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  toolboxItems      ToolboxItem[]
  feedback          ResourceFeedback[]

  @@index([active, approved, category])
  @@map("wellbeing_resource")
}

/// One answer per "what next?" prompt. Read only in aggregate reports; the
/// writer never touches SupportFlag, and no consumer may treat it as one.
model ResourceFeedback {
  id         String                 @id @default(uuid()) @db.Uuid
  studentId  String                 @db.Uuid
  resourceId String                 @db.Uuid
  choice     ResourceFeedbackChoice
  createdAt  DateTime               @default(now())

  student  StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource WellbeingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, createdAt])
  @@index([studentId, createdAt])
  @@map("resource_feedback")
}

model ToolboxItem {
  id         String            @id @default(uuid()) @db.Uuid
  studentId  String            @db.Uuid
  resourceId String            @db.Uuid
  createdAt  DateTime          @default(now())
  student    StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource   WellbeingResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId])
  @@map("toolbox_item")
}

model JournalEntry {
  id        String         @id @default(uuid()) @db.Uuid
  studentId String         @db.Uuid
  title     String?
  content   String
  prompt    String?
  private   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("journal_entry")
}

model SupportPerson {
  id                String               @id @default(uuid()) @db.Uuid
  professionalId    String?              @db.Uuid
  name              String
  type              SupportPersonType
  title             String?
  availabilityLabel String?
  availableToday    Boolean              @default(false)
  imageUrl          String?
  active            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  professional      ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  supportRequests   SupportRequest[]

  @@index([professionalId, type])
  @@map("support_person")
}

model SupportRequest {
  id               String               @id @default(uuid()) @db.Uuid
  studentId        String               @db.Uuid
  supportPersonId  String               @db.Uuid
  personType       SupportPersonType
  timing           SupportTiming
  note             String?
  /// Verbatim snapshot of the student's own message that prompted the request
  /// (latest USER turn of `conversationId` at creation). Frozen on purpose:
  /// later edits or deletions of the AI conversation never change what the
  /// school professional was shown. null on requests created before this
  /// column existed, and on requests with no conversation.
  initialMessage   String?
  initialMessageAt DateTime?
  reviewNote       String?
  status           SupportRequestStatus @default(PENDING)
  checkInId        String?              @db.Uuid
  conversationId   String?              @db.Uuid
  scheduledAt      DateTime?
  locationLabel    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  student       StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supportPerson SupportPerson        @relation(fields: [supportPersonId], references: [id], onDelete: Restrict)
  checkIn       EmotionalCheckIn?    @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  conversation  Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  followUps     FollowUp[]
  reads         SupportRequestRead[]

  @@index([studentId, createdAt])
  @@map("support_request")
}

model SupportRequestRead {
  requestId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([requestId, userId])
  @@map("support_request_read")
}

model SupportFlag {
  id                       String                     @id @default(uuid()) @db.Uuid
  studentId                String                     @db.Uuid
  conversationId           String?                    @db.Uuid
  assigneeId               String?                    @db.Uuid
  studentRef               String
  classLabel               String?
  triggerLabel             String
  category                 String?
  intentId                 String?
  severity                 SupportFlagSeverity
  /// Doc A G1: how serious an indicator is sits on its own axis, never derived
  /// from `severity` (which the alert path still uses) and never guessed: a flag
  /// from a rule with no approved level reads as unclassified.
  level                    IndicatorLevel?
  ruleId                   String?
  ruleVersion              String?
  /// G4: the human decision is a fact apart from the workflow status, so
  /// "acknowledged" and "safeguarding procedure opened" stay distinguishable.
  reviewDecision           SupportFlagReviewDecision?
  /// Verbatim student line frozen at creation (US-D02), reusing the
  /// SupportRequest.initialMessage pattern instead of re-reading live chat.
  studentStatementSnapshot String?
  status                   SupportFlagStatus          @default(OPEN)
  source                   SupportFlagSource
  aiContextSummary         String?
  autoActions              String[]                   @default([])
  createdAt                DateTime                   @default(now())
  resolvedAt               DateTime?
  updatedAt                DateTime                   @updatedAt

  student      StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversation Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignee     ProfessionalProfile? @relation("FlagAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@map("support_flag")
}

model FollowUp {
  id               String         @id @default(uuid()) @db.Uuid
  studentId        String         @db.Uuid
  professionalId   String?        @db.Uuid
  supportRequestId String?        @db.Uuid
  notes            String?
  status           FollowUpStatus @default(PENDING)
  dueAt            DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  student        StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professional   ProfessionalProfile? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  supportRequest SupportRequest?      @relation(fields: [supportRequestId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@map("follow_up")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @db.Uuid
  action      String
  entity      String
  entityId    String?
  meta        Json?
  schoolId    String?  @db.Uuid
  // Optional provenance carried by reviewed record transitions (US-D03/D10): the prior and
  // new lifecycle state and the indicator rule that produced them. Nullable and additive so
  // every existing audit row and caller keeps working untouched.
  priorStatus String?
  newStatus   String?
  ruleId      String?
  ruleVersion String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([schoolId])
  @@map("audit_log")
}

/// Queued regeneration of an AI assistant message that failed its first
/// synchronous attempt. The worker (src/ai/ai-worker.service.ts) re-runs the
/// orchestration and updates the placeholder message in place.
model AiGenerationJob {
  id                    String               @id @default(uuid()) @db.Uuid
  conversationMessageId String?              @unique @db.Uuid
  kind                  AiJobKind            @default(REPLY)
  input                 Json
  attempts              Int                  @default(0)
  lastError             String?
  nextRetryAt           DateTime?
  status                AiJobStatus          @default(PENDING)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  message               ConversationMessage? @relation(fields: [conversationMessageId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([kind, status])
  @@map("ai_generation_job")
}

/// Per-day, per-provider AI usage counters fed by the provider chain after
/// every generation. `day` is server-local date (DB CURRENT_DATE) — raw SQL
/// owned (see src/ai/providers/usage-meter.service.ts), never app-side Date.
model AiUsageDaily {
  id                String   @id @default(uuid()) @db.Uuid
  day               DateTime @db.Date
  provider          String
  requests          Int      @default(0)
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  estimatedUsdCents Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([day, provider])
  @@map("ai_usage_daily")
}

/// AI-written digest of a closed conversation. One row per conversation
/// (enforced by the worker, not a unique constraint — re-close is idempotent).
/// `embedding` is pgvector-owned raw SQL (see src/ai/memory/memory.repository.ts);
/// the schema marks it for typing only.
model SessionSummary {
  id                    String                       @id @default(uuid()) @db.Uuid
  studentId             String                       @db.Uuid
  conversationId        String                       @unique @db.Uuid
  summary               String                       @db.VarChar(400)
  topics                String[]
  followUpHook          String?                      @db.VarChar(140)
  emotionalTrend        String?
  summaryLocalized      String?
  followUpHookLocalized String?
  embedding             Unsupported("vector(1536)")?
  createdAt             DateTime                     @default(now())

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("session_summary")
}

/// Backend-orchestrated coping activity (Phase C step 6). `steps` is the
/// frontend renderer contract — an ordered list of typed steps
/// (breath-pacing | timer | prompt-list | body-scan). Catalogue lives in
/// src/ai/activities/activities.config.ts and is seeded by prisma/seed.ts.
model WellbeingActivity {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique
  title           String
  description     String
  category        ResourceCategory @default(GENERAL)
  steps           Json
  durationSeconds Int
  active          Boolean          @default(true)
  approved        Boolean          @default(false)
  tags            String[]         @default([])
  contentCode     String?          @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions ActivitySession[]

  @@index([active, approved, category])
  @@map("wellbeing_activity")
}

/// A student's run of a WellbeingActivity. `completedAt` + `feelingAfter`
/// are the feel-after signal consumed by the (parked) effectiveness dashboard.
model ActivitySession {
  id             String        @id @default(uuid()) @db.Uuid
  studentId      String        @db.Uuid
  activityId     String        @db.Uuid
  conversationId String?       @db.Uuid
  intentId       String?
  recommendedBy  String?
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  feelingAfter   FeelingLabel?
  noteAfter      String?       @db.VarChar(500)

  student      StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activity     WellbeingActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([studentId, startedAt])
  @@map("activity_session")
}

/// In-app human chat between a student and a professional of the same school.
/// Lifecycle: PENDING (sits in the school request pool) → ACTIVE (a
/// professional claimed it) → CLOSED. Deliberately separate from Conversation
/// (the AI Reflect lane) — no AI runs inside the thread after the entry note.
model ChatThread {
  id                 String           @id @default(uuid()) @db.Uuid
  schoolId           String           @db.Uuid
  studentId          String           @db.Uuid
  professionalId     String?          @db.Uuid
  status             ChatThreadStatus @default(PENDING)
  entryCheckInId     String?          @db.Uuid
  /// AI-composed opening note shown to professionals in the request pool.
  aiEntrySummary     String?
  /// Per-participant read markers backing the unread badge.
  studentReadAt      DateTime?
  professionalReadAt DateTime?
  /// Lifecycle stamps for the admin chat-thread register.
  claimedAt          DateTime?
  closedAt           DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile? @relation("ChatProfessional", fields: [professionalId], references: [id], onDelete: SetNull)
  messages     ChatMessage[]

  @@index([schoolId, status])
  @@index([studentId, status])
  @@index([professionalId])
  @@map("chat_thread")
}

model ChatMessage {
  id           String          @id @default(uuid()) @db.Uuid
  threadId     String          @db.Uuid
  /// Null for SYSTEM rows (the AI-composed entry note).
  senderUserId String?         @db.Uuid
  role         ChatMessageRole
  content      String
  /// True when the text originated from a voice transcription.
  viaVoice     Boolean         @default(false)
  meta         Json?
  createdAt    DateTime        @default(now())

  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser User?      @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("chat_message")
}

/// Per-user notification (chat pool events, replies, suspension notices).
/// `data` carries ids so clients can deep-link (e.g. {threadId}).
/// Unread badge = rows with readAt null; pushed over Socket.IO in realtime.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}
