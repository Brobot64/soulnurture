NODE_ENV=development
PORT=3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/natlas?schema=public

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# SMTP (for verification + password reset emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Natlas <no-reply@soulnurture.ai>"

# Groq AI (optional — backend falls back to safe stub without it)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_MAX_OUTPUT_TOKENS=600
GROQ_TEMPERATURE=0.2

# Bounded AI context (privacy/cost control)
AI_CONTEXT_MESSAGE_LIMIT=12
AI_CONTEXT_CHARACTER_LIMIT=12000

# Async AI generation (in-app DB queue; see src/ai/config/ai.config.ts)
AI_ASYNC_POLL_MS=5000
AI_ASYNC_HOLDING_MESSAGE=Thank you for sharing that with me — I am still thinking on it and will be right here.

# Staff enrolment secret for POST /api/v1/staff/bootstrap; only staff roles allowed.
# Leave empty in shared/production environments to keep the endpoint closed.
STAFF_BOOTSTRAP_KEY=
