NODE_ENV=development
PORT=3000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/natlas?schema=public

# Better Auth
BETTER_AUTH_SECRET=replace-with-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Post-verification redirect target: after the API consumes the token from the
# emailed link, the browser is sent here (/welcome). Defaults to the first
# concrete BETTER_AUTH_TRUSTED_ORIGINS entry when unset.
# WEB_APP_URL=https://soulnurture.vercel.app

# Cross-origin frontends (e.g. the Vercel deployment) need all three:
#   1. the frontend origin added to ALLOWED_ORIGINS above (CORS),
#   2. BETTER_AUTH_TRUSTED_ORIGINS below (better-auth reads it natively —
#      origin checks + redirect validation; "https://*.vercel.app" also works),
#   3. BETTER_AUTH_CROSS_SITE_COOKIES=true so the session cookie is sent
#      cross-site (SameSite=None + Secure).
# Example:
# ALLOWED_ORIGINS=https://soulnurture-frontend.vercel.app
# BETTER_AUTH_TRUSTED_ORIGINS=https://soulnurture-frontend.vercel.app
# BETTER_AUTH_CROSS_SITE_COOKIES=true

# SMTP (for verification + password reset emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Natlas <no-reply@soulnurture.ai>"

# Groq AI (optional — backend falls back to safe stub without it)
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_MAX_OUTPUT_TOKENS=600
GROQ_TEMPERATURE=0.2

# Bounded AI context (privacy/cost control)
AI_CONTEXT_MESSAGE_LIMIT=12
AI_CONTEXT_CHARACTER_LIMIT=12000

# Async AI generation (in-app DB queue; see src/ai/config/ai.config.ts)
AI_ASYNC_POLL_MS=5000
AI_ASYNC_HOLDING_MESSAGE=Thank you for sharing that with me — I am still thinking on it and will be right here.

# AI provider chain (comma-separated; try order, fallback on failure)
AI_PROVIDER_CHAIN=openai,groq

# OpenAI (optional — chain skips it when unset or key-less; Groq/stub serves instead)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1000
# Reasoning models may reject temperature — leave empty unless you know the model accepts it.
OPENAI_TEMPERATURE=

# Daily budget guard: once OpenAI serves this many generations in a day,
# the chain starts at Groq until midnight (server-local day, DB timezone).
OPENAI_DAILY_REQUEST_CAP=400

# Estimator pricing (USD cents per 1M tokens) — feeds AiUsageDaily.estimatedUsdCents.
OPENAI_INPUT_USD_CENTS_PER_1M=15
OPENAI_OUTPUT_USD_CENTS_PER_1M=60
GROQ_INPUT_USD_CENTS_PER_1M=10
GROQ_OUTPUT_USD_CENTS_PER_1M=30

# Staff enrolment secret for POST /api/v1/staff/bootstrap; only staff roles allowed.
# Leave empty in shared/production environments to keep the endpoint closed.
STAFF_BOOTSTRAP_KEY=

# Guardrails (Phase C step 2) — input/output caps + per-student AI chat rate windows.
# The human support route (support-requests) never passes through the rate gate.
AI_MAX_MESSAGE_CHARS=1200
AI_MAX_REPLY_CHARS=700
AI_RATE_LIMIT_DAILY=20
AI_RATE_LIMIT_PER_MINUTE=6

# Guided check-in replies (quick replies + turn budget; see the `guided`
# block in src/ai/config/ai.config.ts). Free-text turns before the wrap-up
# directive: 3 base, extended to 5 once the student taps "Tell more".
# Quick-reply taps never consume the free-text budget, but every student
# turn counts toward the hard total cap — the chat always wraps by turn 5.
AI_GUIDED_MAX_BASE_TURNS=3
AI_GUIDED_MAX_EXTENDED_TURNS=5

# Session-summary memory (Phase C step 3) — requires the pgvector extension
# (CREATE EXTENSION vector; prod image pgvector/pgvector:pg17).
# ACTIVE conversations untouched for this many minutes are closed by the AI
# worker and queued for a session summary.
AI_SESSION_IDLE_MINUTES=120
# OpenAI embedding model for pgvector memory recall; failure degrades the
# memory layer to recency-only (chat keeps working).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Language layer (Phase C step 4) — detection runs offline (diacritics +
# Pidgin wordlist + franc); no LLM sits in the realtime lane.
# Offer the student their detected language once (response metadata
# languageOffer); the student confirms via PATCH /api/v1/students/me.
AI_LANGUAGE_OFFER_ENABLED=true
# 'openai-native' = the frontier model replies in the vernacular directly (built).
# 'n-atlas-translate' = local N-ATLaS translates + second pass replies (pre-wired, post-pilot).
AI_VERNACULAR_REPLY_MODE=openai-native
# Local N-ATLaS (Ollama) for the async VERNACULAR understanding lane.
# Leave empty to route understanding straight to the OpenAI fallback.
NATLAS_LLM_BASE_URL=
NATLAS_LLM_MODEL=n-atlas

# Voice lane (Phase C step 5) — English/Pidgin voice notes go to Groq Whisper
# (chain); Yoruba/Hausa/Igbo go to the local N-ATLaS ASR sidecar
# (services/n-atlas-asr). Without the sidecar, those languages degrade to a
# friendly "type it instead" 503.
NATLAS_ASR_BASE_URL=
NATLAS_ASR_TIMEOUT_MS=60000

# Object storage (S3 / RustFS) — optional; without the full set both upload
# endpoints (POST /api/v1/uploads, POST /api/v1/uploads/presign) answer a
# friendly 503. RustFS bring-up + env details: docs/DEPLOYMENT.md §4.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=natlas-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
