<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Verify your email</title>
</head>

<body>

  <h2>Hello {{name}}</h2>

  <p>
    {{#if schoolName}}
      You have been added to <strong>Soul Nurture AI</strong> from <strong>{{schoolName}}</strong>.
    {{else}}
      Welcome to Soul Nurture AI.
    {{/if}}
  </p>

  {{#if schoolName}}
  <p>
    Sign in with the default password your school gave you. After verifying,
    you will be asked to set your own password.
  </p>
  {{/if}}

  <p>
    Click the button below to verify your email address.
  </p>

  <a href="{{verificationUrl}}">
    Verify Email
  </a>

</body>
</html>
